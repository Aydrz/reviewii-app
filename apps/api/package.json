{
  "name": "@reviewii/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "cd ../.. && npm run build:types && cd apps/api && npx prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "postinstall": "npx --no-install prisma generate",
    "prisma:generate": "npx --no-install prisma generate",
    "prisma:push": "npx --no-install prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.7",
    "@nestjs/config": "^3.2.1",
    "@nestjs/core": "^10.3.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.7",
    "@nestjs/platform-socket.io": "^10.3.7",
    "@nestjs/websockets": "^10.3.7",
    "@prisma/client": "^5.11.0",
    "@reviewii/shared-types": "*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fluent-ffmpeg": "^2.1.2",
    "googleapis": "^134.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.30",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
