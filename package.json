{
  "name": "reviewii-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:types": "npm run build --workspace=packages/shared-types",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build": "npm run build:types && npm run build:web && npm run build:api",
    "postinstall": "npm run build:types && npx prisma generate --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "googleapis": "^174.0.1",
    "typescript": "^7.0.2"
  }
}
